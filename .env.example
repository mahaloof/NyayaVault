# Development configuration template — generate secrets; do not use placeholder values.
DATABASE_URL=sqlite:///./nyayavault.db
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_EXPIRY_MINUTES=60
EVIDENCE_MASTER_KEY=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES
STORAGE_PROVIDER=local
STORAGE_PATH=./data/evidence
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=vault-development
MINIO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
MINIO_BUCKET=evidence
MINIO_SECURE=false
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_SECRET
BLOCKCHAIN_PROVIDER=development
FABRIC_GATEWAY_URL=http://127.0.0.1:4000
FABRIC_GATEWAY_SECRET=REPLACE_WITH_SHARED_RANDOM_SECRET
FABRIC_CHANNEL=nyayachannel
FABRIC_CHAINCODE=nyayavault
# Gateway uses certificate paths, not the legacy connection-profile API.
FABRIC_CONNECTION_PROFILE=
AI_PROVIDER=disabled
AI_API_KEY=
# Use 3001/8001 to run Docker beside the existing local 3000/8000 demo.
FRONTEND_PORT=3000
BACKEND_PORT=8000
